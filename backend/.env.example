# ============================================================
# 密钥模板（backend/.env.example）
# 用法：cp .env.example .env  然后填入你实际在用的厂商密钥。
# .env 已在 .gitignore——密钥永不进 git。
# 只填你在 models.yaml 里启用的厂商即可，其余留空。
# ============================================================

# ---- 国内云端（OpenAI 兼容）----
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=        # 阿里 Qwen
GLM_API_KEY=              # 智谱
MOONSHOT_API_KEY=         # Kimi

# ---- 海外云端 ----
OPENAI_API_KEY=
GEMINI_API_KEY=           # Google Gemini（OpenAI 兼容端点）
ANTHROPIC_API_KEY=        # Claude（原生协议）

# ---- 本地服务（无需密钥，以下仅供部署参考）----
# LM Studio: http://127.0.0.1:1234  （models.yaml lmstudio 节）
# Ollama:    http://127.0.0.1:11434 （models.yaml ollama 节）
